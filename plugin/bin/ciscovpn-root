#!/usr/bin/env bash
# ciscovpn-root — the only part that runs as root (via a dedicated sudoers rule).
#
# It launches `openconnect` to build the Cisco Secure Client (AnyConnect) tunnel
# from an already-obtained SAML session cookie, and tears it down on request.
# Kept deliberately small and with a fixed argument shape so the sudoers rule
# that whitelists it is tight.
#
#   ciscovpn-root connect <server> <protocol> <pidfile> <fingerprint> [extra]
#       -> reads the SAML session cookie from STDIN (never on the command line)
#   ciscovpn-root disconnect <pidfile>
#   ciscovpn-root check
#
# The SAML single-sign-on (CyberArk webview) happens BEFORE this, as the normal
# user, in bin/ciscovpn-saml. This part only consumes the resulting cookie.

set -uo pipefail

cmd="${1:-}"

case "$cmd" in
  check)
    # Used by `doctor` to confirm the passwordless rule works.
    command -v openconnect >/dev/null || exit 3
    exit 0
    ;;

  connect)
    server="${2:?server required}"
    protocol="${3:-anyconnect}"
    pidfile="${4:?pidfile required}"
    fingerprint="${5:-}"
    extra="${6:-}"
    logfile="${7:-}"

    command -v openconnect >/dev/null || { echo "openconnect not installed"; exit 3; }
    mkdir -p "$(dirname "$pidfile")"

    # The session cookie is passed on stdin so it never appears in `ps`/argv.
    saml_cookie="$(cat)"
    [[ -n "$saml_cookie" ]] || { echo "no SAML cookie on stdin"; exit 4; }

    AC_VERSION="4.10.07073"
    servercert_arg=()
    # openconnect accepts the Cisco server-cert-hash verbatim (as openconnect-sso
    # passes it); it also understands sha1:/pin-sha256: prefixes.
    [[ -n "$fingerprint" ]] && servercert_arg=(--servercert "$fingerprint")

    # --cookie-on-stdin  use the SAML session cookie we just obtained
    # --servercert    pin the gateway cert the SSO handshake already saw
    # NOTE: do NOT use --background here. openconnect would fork before fully
    # consuming the piped cookie, which the gateway then rejects (401 / "Cookie
    # was rejected"). We stay in the foreground; the user-side `setsid` detaches
    # the whole helper so operation is still headless.
    # Output goes to the caller's log file so the UI can show progress/errors.
    : "${logfile:=/dev/null}"
    # shellcheck disable=SC2086
    setsid openconnect \
      --protocol="$protocol" \
      --useragent="AnyConnect Linux_64 $AC_VERSION" \
      --version-string="$AC_VERSION" \
      --cookie-on-stdin \
      "${servercert_arg[@]}" \
      --pid-file="$pidfile" \
      $extra \
      "$server" <<<"$saml_cookie" >>"$logfile" 2>&1 &
    oc_pid=$!
    # Give openconnect a moment to read the cookie and bring the tunnel up,
    # then report success based on the interface, and leave it running.
    for _ in $(seq 1 40); do
      sleep 0.5
      ip -o link show 2>/dev/null | grep -qE ': (tun|vpn|cscotun)[0-9]+' && break
      kill -0 "$oc_pid" 2>/dev/null || break
    done
    if ip -o link show 2>/dev/null | grep -qE ': (tun|vpn|cscotun)[0-9]+'; then
      [[ -f "$pidfile" ]] && chmod 0644 "$pidfile" 2>/dev/null || true
      exit 0
    fi
    wait "$oc_pid" 2>/dev/null
    exit ${?:-1}
    ;;

  disconnect)
    pidfile="${2:?pidfile required}"
    if [[ -f "$pidfile" ]]; then
      pid="$(cat "$pidfile" 2>/dev/null)"
      if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null
        for _ in 1 2 3 4 5; do kill -0 "$pid" 2>/dev/null || break; sleep 0.4; done
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
      fi
      rm -f "$pidfile"
    fi
    pkill -f "openconnect .*--pid-file=$pidfile" 2>/dev/null || true
    exit 0
    ;;

  *)
    echo "usage: ciscovpn-root {connect|disconnect|check} ..." >&2
    exit 2
    ;;
esac
