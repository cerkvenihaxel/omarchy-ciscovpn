#!/usr/bin/env bash
# ciscovpn-root — the ONLY component that runs as root (via a dedicated sudoers
# rule). It brings a Cisco AnyConnect tunnel up from an already-obtained SAML
# session cookie, and tears it down.
#
# SECURITY MODEL
#   * This file is installed to a ROOT-OWNED, root-only-writable location
#     (/usr/local/lib/omarchy-ciscovpn/ciscovpn-root) and the sudoers rule
#     whitelists THAT path. The copy inside the user's plugin dir is never what
#     sudo runs, so a user who tampers with the plugin dir cannot gain root.
#   * Every argument from the (unprivileged) caller is strictly validated here.
#   * No caller-supplied free-form arguments are passed to openconnect.
#   * The SAML session cookie is read from stdin only (never argv), and is never
#     written to any file or log by this script.
#   * A server certificate pin is REQUIRED; we refuse to connect without one.
#
#   ciscovpn-root connect <server> <protocol> <pidfile> <fingerprint>
#       -> reads the SAML session cookie from STDIN
#   ciscovpn-root disconnect <pidfile>
#   ciscovpn-root check

set -euo pipefail
umask 077

AC_VERSION="4.10.07073"

# Only these fixed state directories are acceptable for pid files / logs, so a
# caller cannot direct root writes to arbitrary paths. We derive the invoking
# user's home from SUDO_USER (set by sudo), falling back to nothing.
caller="${SUDO_USER:-}"
caller_home=""
if [[ -n "$caller" ]]; then
  caller_home="$(getent passwd "$caller" | cut -d: -f6)"
fi

die() { echo "ciscovpn-root: $*" >&2; exit 10; }

valid_server() {   [[ "$1" =~ ^[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~-]+)?$ ]]; }
valid_protocol() { case "$1" in anyconnect|nc|pulse|gp|f5|fortinet|array) return 0;; *) return 1;; esac; }
valid_fp() {       [[ "$1" =~ ^((sha1|sha256|pin-sha256):)?[A-Fa-f0-9:+/=]+$ ]]; }
valid_statepath() {
  # pidfile/logfile must live under the caller's own omarchy ciscovpn state dir.
  local p="$1"
  [[ -n "$caller_home" ]] || return 1
  local base="$caller_home/.local/state/omarchy/ciscovpn"
  case "$p" in
    "$base"/*) [[ "$p" != *".."* ]] ;;
    *) return 1 ;;
  esac
}

cmd="${1:-}"

case "$cmd" in
  check)
    command -v openconnect >/dev/null || exit 3
    exit 0
    ;;

  connect)
    server="${2:-}"; protocol="${3:-anyconnect}"; pidfile="${4:-}"; fingerprint="${5:-}"

    command -v openconnect >/dev/null || die "openconnect not installed"
    valid_server   "$server"      || die "invalid server"
    valid_protocol "$protocol"    || die "invalid protocol"
    valid_statepath "$pidfile"    || die "invalid pidfile path"
    [[ -n "$fingerprint" ]]       || die "refusing to connect without a server certificate pin"
    valid_fp "$fingerprint"       || die "invalid fingerprint"

    mkdir -p "$(dirname "$pidfile")"
    logfile="$(dirname "$pidfile")/connect.log"

    # Cookie strictly from stdin; never placed in argv or any file.
    saml_cookie="$(cat)"
    [[ -n "$saml_cookie" ]] || die "no SAML cookie on stdin"

    rm -f "$pidfile"
    # No caller free-form args. Fixed, audited argument set only.
    # Detached in its own session so it survives this helper exiting, but NOT
    # with --background (which races with --cookie-on-stdin). openconnect writes
    # its own PID to --pid-file; we track THAT (setsid's pid exits immediately).
    # Its progress/errors go to the log so the UI can diagnose failures.
    echo "--- openconnect $(date) ---" >>"$logfile"
    setsid openconnect \
      --protocol="$protocol" \
      --useragent="AnyConnect Linux_64 $AC_VERSION" \
      --version-string="$AC_VERSION" \
      --cookie-on-stdin \
      --servercert "$fingerprint" \
      --pid-file="$pidfile" \
      "$server" <<<"$saml_cookie" >>"$logfile" 2>&1 &
    disown 2>/dev/null || true

    # Wait for the tunnel interface to appear. Guard every command so `set -e`
    # never aborts the loop on a non-zero grep/ip/kill.
    up=0
    for _ in $(seq 1 40); do
      sleep 0.5
      if ip -o link show 2>/dev/null | grep -qE ': (tun|vpn|cscotun)[0-9]+'; then up=1; break; fi
      if [[ -f "$pidfile" ]]; then
        p="$(cat "$pidfile" 2>/dev/null || true)"
        if [[ "$p" =~ ^[0-9]+$ ]] && ! kill -0 "$p" 2>/dev/null; then break; fi
      fi
    done
    if [[ "$up" -eq 1 ]]; then
      [[ -f "$pidfile" ]] && chmod 0644 "$pidfile" 2>/dev/null || true
      [[ -n "$caller" ]] && chown "$caller" "$logfile" 2>/dev/null || true
      exit 0
    fi
    [[ -n "$caller" ]] && chown "$caller" "$logfile" 2>/dev/null || true
    exit 1
    ;;

  disconnect)
    pidfile="${2:-}"
    server="${3:-}"
    valid_statepath "$pidfile" || die "invalid pidfile path"
    [[ -n "$server" ]] && { valid_server "$server" || die "invalid server"; }

    killed=0
    if [[ -f "$pidfile" ]]; then
      pid="$(cat "$pidfile" 2>/dev/null || true)"
      if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        if grep -qa openconnect "/proc/$pid/comm" 2>/dev/null \
           || [[ "$(readlink -f "/proc/$pid/exe" 2>/dev/null)" == *openconnect* ]]; then
          kill "$pid" 2>/dev/null || true
          for _ in 1 2 3 4 5; do kill -0 "$pid" 2>/dev/null || break; sleep 0.4; done
          kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
          killed=1
        fi
      fi
      rm -f "$pidfile"
    fi

    # If the pid file was lost but a tunnel is still up, find the openconnect we
    # own for THIS server and stop it. We match argv exactly (comm=openconnect
    # AND the server appears in its cmdline), so we never touch unrelated procs.
    if [[ "$killed" -eq 0 && -n "$server" ]]; then
      for pid in $(pgrep -x openconnect 2>/dev/null || true); do
        if tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -qF " $server"; then
          kill "$pid" 2>/dev/null || true
          for _ in 1 2 3 4 5; do kill -0 "$pid" 2>/dev/null || break; sleep 0.4; done
          kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
        fi
      done
    fi
    exit 0
    ;;

  *)
    echo "usage: ciscovpn-root {connect|disconnect|check} ..." >&2
    exit 2
    ;;
esac
