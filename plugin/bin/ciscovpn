#!/usr/bin/env bash
# ciscovpn — Cisco AnyConnect/Secure Client VPN control for the Omarchy bar plugin.
#
# Uses the open-source `openconnect` client to speak the Cisco Secure Client
# (AnyConnect) protocol, authenticating through SAML/SSO (CyberArk) with the
# system browser via openconnect's --external-browser handshake.
#
# Commands (all print JSON on stdout unless noted):
#   status            report connection state (reads pid/state files; no root)
#   config            print saved config (server, protocol) as JSON
#   set-server HOST   save the VPN gateway host
#   connect           start the SSO connect flow in a styled terminal
#   disconnect        tear down the tunnel (needs root helper)
#   doctor            human-readable diagnostics (plain text)
#   _run-connect      INTERNAL: the actual openconnect invocation (runs in the terminal)
#   _browser URL      INTERNAL: --external-browser target; opens URL as the user
#
# Privilege model: openconnect needs root to configure the tun device. A tiny
# root helper (bin/ciscovpn-root) is whitelisted in sudoers by install.sh so the
# bar can connect/disconnect without a password prompt. The SAML browser is
# always launched as the logged-in user.

set -uo pipefail

PLUGIN_ID="custom.ciscovpn"
PLUGIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
SELF="$PLUGIN_DIR/bin/ciscovpn"
# The privileged helper always runs through an interactive `sudo` (the user
# authenticates each connect/disconnect in a terminal). There is no passwordless
# sudoers rule and no standing root grant, so the helper simply runs from the
# plugin dir.
ROOT_HELPER="$PLUGIN_DIR/bin/ciscovpn-root"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/ciscovpn"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/ciscovpn"
CONFIG_FILE="$CONFIG_DIR/config.json"
PID_FILE="$STATE_DIR/openconnect.pid"
STATE_FILE="$STATE_DIR/state"          # one of: disconnected|connecting|connected|error
LOG_FILE="$STATE_DIR/connect.log"
SERVER_RUNTIME="$STATE_DIR/server"     # host actually used for the live tunnel

mkdir -p "$STATE_DIR" "$CONFIG_DIR"
chmod 0700 "$STATE_DIR" "$CONFIG_DIR" 2>/dev/null || true

# ----------------------------------------------------------------- helpers
json_escape() { python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }

read_config() {
  CFG_SERVER=""; CFG_PROTOCOL="anyconnect"; CFG_BROWSER=""; CFG_EXTRA=""; CFG_AUTHGROUP=""
  [[ -f "$CONFIG_FILE" ]] || return 0
  eval "$(python3 - "$CONFIG_FILE" <<'PY'
import json,sys,shlex
try:
    d=json.load(open(sys.argv[1]))
except Exception:
    d={}
def emit(k,v): print("%s=%s"%(k,shlex.quote(str(v))))
emit("CFG_SERVER", d.get("server",""))
emit("CFG_PROTOCOL", d.get("protocol","anyconnect"))
emit("CFG_BROWSER", d.get("browser",""))
emit("CFG_EXTRA", d.get("extraArgs",""))
emit("CFG_AUTHGROUP", d.get("authgroup",""))
PY
)"
}

write_config() { # key value  (string)
  python3 - "$CONFIG_FILE" "$1" "$2" <<'PY'
import json,sys,os
path,key,val=sys.argv[1],sys.argv[2],sys.argv[3]
try: d=json.load(open(path))
except Exception: d={}
d[key]=val
os.makedirs(os.path.dirname(path),exist_ok=True)
json.dump(d,open(path,"w"),indent=2)
PY
}

get_state() { [[ -f "$STATE_FILE" ]] && cat "$STATE_FILE" || echo disconnected; }
set_state() { echo "$1" > "$STATE_FILE"; }

tun_up() {
  # Connected if our pid file points at a live process …
  local pid
  if [[ -f "$PID_FILE" ]]; then
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi
  # … or an openconnect we own is running for this gateway with a tun up.
  # (covers a tunnel whose pid file was lost, e.g. after a crash/manual kill)
  if pgrep -f "openconnect .*${CFG_SERVER:-__nope__}" >/dev/null 2>&1; then
    if ip -o link show 2>/dev/null | grep -qE ': (tun|vpn|cscotun)[0-9]+'; then
      return 0
    fi
  fi
  return 1
}

# ----------------------------------------------------------------- commands
cmd_status() {
  read_config
  local state iface ip server
  if tun_up; then
    state="connected"
  else
    # if the process died but we were connecting, surface the stale state
    local s; s="$(get_state)"
    if [[ "$s" == "connecting" ]]; then state="connecting"; else state="disconnected"; fi
  fi
  set_state "$state"

  # best-effort interface + ip (tun0/vpn0 are the usual names openconnect uses)
  iface=""; ip=""
  for i in $(ip -o link show 2>/dev/null | awk -F': ' '/tun|vpn|cscotun/{print $2}'); do
    iface="$i"
    ip="$(ip -o -4 addr show "$i" 2>/dev/null | awk '{print $4}' | head -1)"
    break
  done
  server="$CFG_SERVER"
  [[ -f "$SERVER_RUNTIME" ]] && server="$(cat "$SERVER_RUNTIME")"

  printf '{"state":%s,"server":%s,"interface":%s,"ip":%s,"configured":%s}\n' \
    "$(json_escape "$state")" \
    "$(json_escape "$server")" \
    "$(json_escape "$iface")" \
    "$(json_escape "$ip")" \
    "$([[ -n "$CFG_SERVER" ]] && echo true || echo false)"
}

cmd_config() {
  read_config
  printf '{"server":%s,"protocol":%s,"browser":%s,"extraArgs":%s}\n' \
    "$(json_escape "$CFG_SERVER")" "$(json_escape "$CFG_PROTOCOL")" \
    "$(json_escape "$CFG_BROWSER")" "$(json_escape "$CFG_EXTRA")"
}

cmd_set_server() {
  local host="${1:-}"
  # strip scheme/trailing slash if the user pasted a URL
  host="${host#https://}"; host="${host#http://}"; host="${host%%/*}"
  [[ -z "$host" ]] && { echo '{"ok":false,"error":"empty host"}'; return 1; }
  write_config server "$host"
  printf '{"ok":true,"server":%s}\n' "$(json_escape "$host")"
}

cmd_connect() {
  read_config
  if [[ -z "$CFG_SERVER" ]]; then
    echo '{"ok":false,"error":"no server configured"}'; return 1
  fi
  if tun_up; then echo '{"ok":true,"already":true}'; return 0; fi
  : > "$LOG_FILE"

  # Always run in a terminal: the SSO webview appears, then you authorize the
  # tunnel with your sudo password right there. No standing passwordless grant.
  set_state "connecting"
  omarchy-launch-tui --app-id=org.omarchy.ciscovpn-connect \
    bash -lc "'$SELF' _run-connect" >/dev/null 2>&1 &
  echo '{"ok":true,"launched":true}'
}

# Shared: run the SAML webview as the user and echo "server|cookie|fingerprint".
_saml_authenticate() {
  local saml_helper="$PLUGIN_DIR/bin/ciscovpn-saml"
  local saml_json
  saml_json="$("$saml_helper" "$CFG_SERVER" "$CFG_AUTHGROUP" 2>>"$LOG_FILE")"
  local rc=$?
  [[ $rc -ne 0 || -z "$saml_json" ]] && return 1
  python3 - "$saml_json" <<'PY'
import json,sys
d=json.loads(sys.argv[1])
print("%s\t%s\t%s" % (d.get("server",""), d.get("cookie",""), d.get("fingerprint","")))
PY
}

# Terminal connect: SSO webview (GUI) appears, then you authorize the tunnel
# with your sudo password in this terminal. openconnect then runs in the
# background; the window can be closed once connected.
cmd__run_connect() {
  read_config
  echo "$CFG_SERVER" > "$SERVER_RUNTIME"

  echo "== Cisco VPN (openconnect + SAML/CyberArk) =="
  echo "Gateway : $CFG_SERVER"
  echo

  set_state "connecting"

  echo "Opening the SSO login window — complete your CyberArk sign-in there…"
  local parsed server cookie fingerprint
  parsed="$(_saml_authenticate)" || {
    set_state "error"; echo "SSO login failed (see $LOG_FILE)."
    rm -f "$SERVER_RUNTIME"; set_state "disconnected"
    echo; read -rp "Press Enter to close."; return 1
  }
  IFS=$'\t' read -r server cookie fingerprint <<<"$parsed"

  echo "SSO complete. Enter your sudo password to bring up the VPN tunnel."
  echo
  printf '%s' "$cookie" | sudo "$ROOT_HELPER" connect \
      "$server" "${CFG_PROTOCOL:-anyconnect}" "$PID_FILE" "$fingerprint"
  local rc=$?

  if [[ $rc -eq 0 ]] && tun_up; then
    set_state "connected"
    echo
    echo "Connected. You can close this window; the VPN stays up in the background."
    read -rp "Press Enter to close."
  else
    set_state "error"
    rm -f "$PID_FILE" "$SERVER_RUNTIME"; set_state "disconnected"
    echo; echo "Connection failed (exit $rc). See $LOG_FILE."
    read -rp "Press Enter to close."
  fi
}

cmd__browser() {
  # Invoked by openconnect as the external browser handler with the SSO URL.
  # openconnect runs as root; we must open the browser as the real user.
  local url="${1:-}"
  [[ -z "$url" ]] && exit 1
  # If we're root (called from the root helper's openconnect), drop to user.
  local target_user="${SUDO_USER:-${CISCOVPN_USER:-$USER}}"
  if [[ "$(id -u)" -eq 0 && -n "$target_user" && "$target_user" != "root" ]]; then
    local uid; uid="$(id -u "$target_user")"
    sudo -u "$target_user" \
      env DISPLAY="${DISPLAY:-:0}" \
          WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}" \
          XDG_RUNTIME_DIR="/run/user/$uid" \
      xdg-open "$url" >/dev/null 2>&1 &
  else
    xdg-open "$url" >/dev/null 2>&1 &
  fi
}

cmd_disconnect() {
  read_config
  if ! tun_up && [[ "$(get_state)" == "disconnected" ]]; then
    echo '{"ok":true,"already":true}'; return 0
  fi
  # Tear down in a terminal so you can authorize with your sudo password.
  omarchy-launch-tui --app-id=org.omarchy.ciscovpn-disconnect \
    bash -lc "sudo '$ROOT_HELPER' disconnect '$PID_FILE' '$CFG_SERVER'; echo; echo Disconnected.; sleep 1" \
    >/dev/null 2>&1 &
  rm -f "$PID_FILE" "$SERVER_RUNTIME"
  # Verify shortly after; status polling will also catch up.
  sleep 2
  if tun_up; then
    echo '{"ok":false,"error":"authorize the disconnect in the terminal"}'
  else
    set_state "disconnected"
    echo '{"ok":true}'
  fi
}

cmd_doctor() {
  read_config
  echo "Cisco VPN plugin diagnostics"
  echo "============================"
  echo "openconnect : $(command -v openconnect || echo 'MISSING — install it')"
  openconnect --version 2>/dev/null | head -1
  echo "server      : ${CFG_SERVER:-<not set>}"
  echo "protocol    : ${CFG_PROTOCOL:-anyconnect}"
  if python3 -c "import openconnect_sso, PyQt6.QtWebEngineWidgets" >/dev/null 2>&1; then
    echo "saml webview: OK (openconnect_sso + PyQt6 WebEngine)"
  else
    echo "saml webview: MISSING — run: yay -S openconnect-sso"
  fi
  echo "state       : $(get_state)"
  echo "root helper : $ROOT_HELPER"
  echo "privilege   : interactive sudo per connect/disconnect (no standing root grant)"
  echo "browser     : $(command -v xdg-open || echo 'MISSING')"
  echo
  echo "Recent connect log:"
  echo "-------------------"
  tail -n 30 "$LOG_FILE" 2>/dev/null || echo "(none)"
}

cmd_stats() {
  read_config
  # Resource usage of the plugin's only real consumer: openconnect (while up).
  # The bar widget itself has no process; it just polls `status`. We report
  # openconnect RSS (KB), CPU%, elapsed time, and the tunnel's RX/TX bytes.
  local pid rss cpu etime iface rx tx
  pid=""
  if [[ -f "$PID_FILE" ]]; then
    local p; p="$(cat "$PID_FILE" 2>/dev/null)"
    [[ "$p" =~ ^[0-9]+$ ]] && kill -0 "$p" 2>/dev/null && pid="$p"
  fi
  [[ -z "$pid" ]] && pid="$(pgrep -x openconnect 2>/dev/null | head -1)"

  rss=0; cpu="0.0"; etime=""
  if [[ -n "$pid" ]] && [[ -r "/proc/$pid/status" ]]; then
    rss="$(awk '/VmRSS/{print $2}' "/proc/$pid/status" 2>/dev/null || echo 0)"
    read -r cpu etime < <(ps -o %cpu=,etime= -p "$pid" 2>/dev/null | awk '{print $1, $2}')
    cpu="${cpu:-0.0}"; etime="${etime:-}"
  fi

  iface=""; rx=0; tx=0
  for i in $(ip -o link show 2>/dev/null | awk -F': ' '/tun|vpn|cscotun/{print $2}'); do
    iface="$i"
    rx="$(cat "/sys/class/net/$i/statistics/rx_bytes" 2>/dev/null || echo 0)"
    tx="$(cat "/sys/class/net/$i/statistics/tx_bytes" 2>/dev/null || echo 0)"
    break
  done

  printf '{"running":%s,"pid":%s,"rssKb":%s,"cpu":%s,"uptime":%s,"interface":%s,"rxBytes":%s,"txBytes":%s}\n' \
    "$([[ -n "$pid" ]] && echo true || echo false)" \
    "$([[ -n "$pid" ]] && echo "$pid" || echo 0)" \
    "${rss:-0}" \
    "$(json_escape "${cpu:-0.0}")" \
    "$(json_escape "${etime:-}")" \
    "$(json_escape "$iface")" \
    "${rx:-0}" "${tx:-0}"
}

cmd_kill() {
  # "Close/kill the plugin": disconnect the VPN and remove the widget from the
  # bar so it no longer runs/polls. The plugin files stay installed; re-add with
  # `omarchy bar put custom.ciscovpn` or the panel.
  cmd_disconnect >/dev/null 2>&1 || true
  if command -v omarchy-bar >/dev/null 2>&1; then
    omarchy-bar remove "$PLUGIN_ID" >/dev/null 2>&1 || true
  fi
  echo '{"ok":true,"removed":true}'
}

case "${1:-status}" in
  status)                 cmd_status ;;
  config)                 cmd_config ;;
  set-server)             shift; cmd_set_server "${1:-}" ;;
  connect)                cmd_connect ;;
  disconnect)             cmd_disconnect ;;
  stats)                  cmd_stats ;;
  kill)                   cmd_kill ;;
  doctor)                 cmd_doctor ;;
  _run-connect)           cmd__run_connect ;;
  _browser)               shift; cmd__browser "${1:-}" ;;
  *) echo "{\"error\":\"unknown command: $1\"}"; exit 2 ;;
esac
